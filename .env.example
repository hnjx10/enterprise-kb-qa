# 复制成 .env 后按需修改；环境变量优先级高于本文件
# 命名规则：KBQA_ + 段名__字段名（双下划线）

KBQA_ENV=dev
KBQA_LOG_LEVEL=INFO
KBQA_LOG_JSON=false

# ---- 分块（改动后必须 kbqa ingest 重建索引）----
# KBQA_CHUNK__TARGET_CHARS=300
# KBQA_CHUNK__MAX_CHARS=700
# KBQA_CHUNK__MIN_CHARS=80
# KBQA_CHUNK__OVERLAP_SENTENCES=1

# ---- 检索 ----
# KBQA_RETRIEVAL__VECTOR_TOP_K=12
# KBQA_RETRIEVAL__KEYWORD_TOP_K=12
# KBQA_RETRIEVAL__RRF_K=60
# KBQA_RETRIEVAL__FINAL_TOP_K=5
# KBQA_RETRIEVAL__OVERSAMPLE=4

# ---- 嵌入：hashing 离线可跑，qwen 走真实模型 ----
KBQA_EMBEDDING__PROVIDER=hashing
KBQA_EMBEDDING__DIM=512
# KBQA_EMBEDDING__PROVIDER=qwen
# KBQA_EMBEDDING__MODEL=text-embedding-v3
# KBQA_EMBEDDING__API_KEY=sk-xxx

# ---- 生成：extractive 离线抽取式，qwen 走模型 ----
KBQA_LLM__PROVIDER=extractive
# KBQA_LLM__PROVIDER=qwen
# KBQA_LLM__MODEL=qwen-plus
# KBQA_LLM__API_KEY=sk-xxx

# ---- 缓存：Redis 不通时自动降级进程内 LRU ----
# KBQA_CACHE__REDIS_URL=redis://127.0.0.1:6379/0
# KBQA_CACHE__TTL_S=300

# ---- 元数据：sqlite 本地，mysql 生产 ----
KBQA_STORE__BACKEND=sqlite
# KBQA_STORE__BACKEND=mysql
# KBQA_STORE__MYSQL_HOST=127.0.0.1
# KBQA_STORE__MYSQL_USER=root
# KBQA_STORE__MYSQL_PASSWORD=***
# KBQA_STORE__MYSQL_DATABASE=kbqa

# ---- 词表：换语料时同步换掉 ----
# KBQA_LEXICON=data/lexicon.txt
# KBQA_SYNONYMS=data/synonyms.txt
